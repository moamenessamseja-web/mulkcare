# Public frontend env — copied into the browser bundle.
# These are NOT secrets. Never put a provider service key, database password or
# connection string in this file: everything here is readable by the user.

# Where the app reads its data from.
#   demo   (default) — the clearly labelled sample data set in src/data/mockData.js
#   remote           — a real backend; requires VITE_API_BASE_URL
VITE_DATA_SOURCE=demo

# Authentication mode.
#   demo   (default) — local demo account only; no password is ever stored or sent
#   remote           — real sign-in against the backend auth endpoints
VITE_AUTH_MODE=demo

# Base URL of the REST backend, e.g. https://api.example.com
# Required only when any mode above is set to `remote`.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Provider runtime env names (set these in the provider UI / CLI prompt, never
# in chat and never inside this file):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY            (public; safe for the browser with RLS on)
#   SUPABASE_SERVICE_ROLE_KEY    (SERVER ONLY — must never reach the client)
# ---------------------------------------------------------------------------
